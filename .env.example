# =============================================================================
#  SALIN berkas ini menjadi ".env.local" lalu isi nilainya.
#  Lihat PANDUAN.md → Langkah 2 untuk cara mendapatkan setiap kunci.
# =============================================================================

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → anon / public key
# Tempel di sini kunci "publishable" (sb_publishable_...) atau "anon" (eyJ...).
# Boleh juga pakai nama NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY seperti yang ditampilkan Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Alamat website setelah online (tanpa garis miring di akhir).
# Saat mencoba di laptop biarkan http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

